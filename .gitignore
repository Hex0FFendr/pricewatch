# --- Credential-bearing state. Never commit any of this. ---
# Browser profile directories (contain live session cookies, tokens, IndexedDB).
profiles/
# Exported session state (cookies + localStorage, possibly encrypted).
sessions/
*.session.json
# Raw endpoint captures from `pricewatch discover`. Redacted at capture time,
# but treated as radioactive regardless.
scratch/
captures/
# Resolved local config: may contain literal tokens rather than env refs.
config.toml
pricewatch.toml

# --- Local data ---
*.db
*.db-wal
*.db-shm

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/

# --- Tooling caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
